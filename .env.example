# Copy to .env.local for development. Both values are public by design;
# row level security protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Optional: error alerts. Create a free project at sentry.io (React) and paste its DSN.
VITE_SENTRY_DSN=

# Ticketing is a separate launch. Keep false until the payment staging checks pass.
VITE_MARKETPLACE_ENABLED=false

# Real operator details; do not publish placeholder identities.
VITE_SITE_URL=
VITE_COMPANY_NAME=
VITE_COMPANY_RC=
VITE_COMPANY_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=
# Set only after the operator has reviewed and approved the actual policies.
VITE_TERMS_REVIEWED=false
